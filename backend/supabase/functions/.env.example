# ============================================================
# CLICKFOOD — PayFast payment secrets (names only, no values)
#
# Edge Functions read secrets from Supabase's secret store, never from a
# file. Set them with:
#
#   supabase secrets set NAME=value --project-ref ctxnwjjpqxecidzblyok
#
# or in the Dashboard: Project Settings -> Edge Functions -> Secrets.
# Never commit real values anywhere in this repository.
# ============================================================

# sandbox (default) or live. Live ALSO needs PAYFAST_ALLOW_LIVE=yes, so a
# single wrong value can never start taking real money.
PAYFAST_MODE=sandbox

# Sandbox: log in at https://sandbox.payfast.co.za with your PayFast login.
# Settings -> Developer Settings shows the sandbox Merchant ID and Key.
# Set a Salt Passphrase there too, and put the same value here.
PAYFAST_SANDBOX_MERCHANT_ID=
PAYFAST_SANDBOX_MERCHANT_KEY=
PAYFAST_SANDBOX_PASSPHRASE=

# Live: only after PayFast has verified the merchant account.
# https://www.payfast.co.za -> Settings -> Developer Settings.
PAYFAST_LIVE_MERCHANT_ID=
PAYFAST_LIVE_MERCHANT_KEY=
PAYFAST_LIVE_PASSPHRASE=
PAYFAST_ALLOW_LIVE=

# Optional: extra pages allowed as PayFast return addresses, comma
# separated origins (e.g. a custom domain). clickfud-customer.vercel.app
# and localhost are always allowed.
PAYFAST_RETURN_ORIGINS=

# RecessBox bridge (shared with RecessBox's server only).
CAMPUSBOX_BRIDGE_SECRET=

# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are
# provided automatically by the Supabase Edge Runtime.
